# ===================================================
# Merald Group Backend Server Environment Configuration
# ===================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas URI)
# Local Example: mongodb://127.0.0.1:27017/merald_group_db
# Atlas Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/merald_group_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/merald_group_db

# JWT & Authentication Secret
JWT_SECRET=merald_group_super_secret_jwt_key_2026_prod_grade
JWT_EXPIRES_IN=7d

# Client URL (For CORS Security - single URL or comma-separated list via CLIENT_URLS)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,https://merald-group-web.vercel.app

# ===================================================
# Transactional Email (SMTP Transporter) Configuration
# ===================================================
# SMTP Host server address
SMTP_HOST=smtp.example.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use secure connection (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP authentication username
SMTP_USER=smtp_user@example.com

# SMTP authentication password
SMTP_PASSWORD=smtp_password_placeholder

# Branded sender display name in outgoing emails
EMAIL_FROM_NAME="Merald Group HR"

# System sender email address used in From header
EMAIL_FROM_ADDRESS=no-reply@meraldgroup.com

# ===================================================
# Auto-seed HR Account Credentials
# ===================================================
# Target email address for auto-seeded HR manager account
SEED_HR_EMAIL=hr.admin@meraldgroup.com

# Initial password for auto-seeded HR manager account (will be hashed with bcrypt)
SEED_HR_PASSWORD=ChangeMeInProd123!
