# ===================================================
# Merald Group Backend Server Environment Configuration
# ===================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas URI)
# Local Example: mongodb://127.0.0.1:27017/merald_group_db
# Atlas Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/merald_group_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/merald_group_db

# JWT & Authentication Secret
JWT_SECRET=merald_group_super_secret_jwt_key_2026_prod_grade
JWT_EXPIRES_IN=7d

# Client URL (For CORS Security)
CLIENT_URL=http://localhost:5173
